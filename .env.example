# Server-only environment variables for the Konoha-gotchi dashboard.
# Do not prefix these with NEXT_PUBLIC_. Browser code must not receive Supabase keys.
# Keep real values in .env.local for local development. Never commit .env, .env.local,
# .env.production, or any other file containing real secrets.

SUPABASE_URL=
SUPABASE_SECRET_KEY=
KONOHA_INGESTION_TOKEN=
KONOHA_DEFAULT_DEVICE_ID=konoha-esp32-01
KONOHA_USE_MOCK_FALLBACK=false

# Vercel setup:
# - Store real values in Project Settings > Environment Variables.
# - Use Production variables for production deployments.
# - Use Preview variables for the dev branch and preview deployments.
# - Mark secret values as sensitive where possible.
# - Redeploy after changing environment variables.
